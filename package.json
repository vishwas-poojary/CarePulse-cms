{
  "name": "carepulse-cms-admin",
  "version": "1.0.0",
  "description": "CarePulse Health Clinic Payload CMS Admin",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3000",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3000",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "seed": "tsx ./src/seed.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3000",
    "prepare": "husky",
    "cspell": "cspell --no-must-find-files \"**/*\"",
    "spellcheck": "cspell --no-must-find-files \"**/*\""
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.10.0",
    "next": "16.4.0",
    "payload": "3.90.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "cspell": "^10.3.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*": "cspell --no-must-find-files"
  }
}
